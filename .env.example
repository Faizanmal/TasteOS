# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# demo = labeled sample dataset only (no Qloo network calls)
# live = real Qloo Search + Insights (requires QLOO_API_KEY)
TASTEOS_MODE=demo

# Qloo Taste AI — server-side only; never put this in NEXT_PUBLIC_* or the browser.
# Request key: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key
# Hackathon keys ONLY work on the hackathon host (401 on staging/production hosts).
# Auth header used by the client: X-Api-Key
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=30
# Retries apply to transient failures and HTTP 429 (not to 401/403/validation errors).
QLOO_MAX_RETRIES=2

# Database (PostgreSQL via psycopg async driver)
# Local Postgres example: postgresql+psycopg://tasteos:tasteos@localhost:5432/tasteos
# Docker Compose service example: postgresql+psycopg://tasteos:tasteos_secure_password@db:5432/tasteos
DATABASE_URL=postgresql+psycopg://tasteos:tasteos_secure_password@db:5432/tasteos

# CORS / frontend
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra CORS origins (Vercel production + preview)
CORS_ORIGINS=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional API key for protecting write endpoints in production (leave empty for local demo)
TASTEOS_API_KEY=

# Rate limiting (requests per minute per IP for public endpoints)
RATE_LIMIT_PER_MINUTE=60
